# WaifuBot environment configuration (placeholders only)
# Copy this file to .env and fill in with your real values. Never commit .env.

# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=123456789
DESTINATION_CHAT_ID=-1001234567890

# ==============================================================================
# Image Generation Provider
# ==============================================================================
PROVIDER_ENABLED=true
PROVIDER_NAME=perchance_playwright
PROVIDER_PAGE_URL=https://perchance.org/ai-text-to-image-generator
PROVIDER_HEADLESS=false

# ==============================================================================
# AI Provider & Models (Character Chat, Persona AI Enhance & Prompt Engineering)
# Supported AI_PROVIDER values: openrouter | google | anthropic | openai | mock
# ==============================================================================

# Choose provider: openrouter, google, anthropic, or openai
AI_PROVIDER=openrouter

# --- Option A: OpenRouter (Recommended for wide model choice & affordability) ---
# Supports Google Gemini, Anthropic Claude, Meta LLaMA, DeepSeek, etc. with a single key
OPENROUTER_API_KEY=your_openrouter_api_key_here
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_CHAT_MODEL=google/gemini-2.0-flash-001
# AI_CHAT_COMPACT_MODEL=google/gemini-2.0-flash-001
# AI_ENHANCE_MODEL=google/gemini-2.0-flash-001

# --- Option B: Google Gemini API (Direct from Google AI Studio) ---
# Get key from: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_CHAT_MODEL=gemini-2.0-flash
# AI_CHAT_COMPACT_MODEL=gemini-2.0-flash
# AI_ENHANCE_MODEL=gemini-2.0-flash

# --- Option C: Anthropic Claude (Direct from Anthropic Console) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# AI_CHAT_MODEL=claude-3-5-haiku-latest
# AI_CHAT_COMPACT_MODEL=claude-3-5-haiku-latest
# AI_ENHANCE_MODEL=claude-3-5-haiku-latest

# --- Option D: OpenAI / Groq / Local LLM (Ollama, vLLM, LM Studio) ---
# OPENAI_API_KEY=your_openai_or_groq_key_here
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4o-mini
# AI_CHAT_COMPACT_MODEL=gpt-4o-mini
# AI_ENHANCE_MODEL=gpt-4o-mini

# ==============================================================================
# Storage & Database
# ==============================================================================
STORAGE_ROOT=./storage
DB_URL=sqlite+aiosqlite:///./storage/waifubot.db
DATABASE_URL=sqlite+aiosqlite:///./storage/waifubot.db
DISK_FLOOR_BYTES=2147483648

# ==============================================================================
# Safety & Limits
# ==============================================================================
ALLOW_NSFW=false
MAX_IMAGES_PER_JOB=4
MAX_JOBS_PER_DAY=20

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=INFO