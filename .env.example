# WaifuBot environment configuration (placeholders only)
# Copy to .env and fill in. Never commit .env.

# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=123456789
DESTINATION_CHAT_ID=-1001234567890

# Provider
PROVIDER_ENABLED=true
PROVIDER_NAME=perchance_playwright
PROVIDER_PAGE_URL=https://perchance.org/ai-text-to-image-generator
PROVIDER_HEADLESS=false

# Safety
# ALLOW_NSFW: true/false — admin-controlled switch (user decision 2026-10-16).
# Note: the minor-protection checks (adult-identity + minor-coded blocklist) always run.
ALLOW_NSFW=false
MAX_IMAGES_PER_JOB=4   # default only - the admin can change it in /settings (up to 20)
MAX_JOBS_PER_DAY=20   # default only - the admin can change it in /settings (up to 100)

# Storage
STORAGE_ROOT=./storage
DB_URL=sqlite+aiosqlite:///./storage/waifubot.db

# Disk floor (bytes)
DISK_FLOOR_BYTES=2147483648

# Logging
LOG_LEVEL=INFO